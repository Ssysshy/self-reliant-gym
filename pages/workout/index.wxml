<view class="page" wx:if="{{ ready }}">
  <!-- 顶部：今天练什么 + 收尾入口 -->
  <view class="top">
    <view class="top-main">
      <view class="eyebrow">今天在练</view>
      <view class="focus">{{ focus }}</view>
    </view>
    <view wx:if="{{ !saved }}" class="end" bindtap="confirmEnd" hover-class="end-on">结束</view>
  </view>

  <!-- 一组一格：比一根细条更能看出还剩几组 -->
  <view class="ticks">
    <view wx:for="{{ ticks }}" wx:key="i" class="tick t{{ item.s }}"></view>
  </view>
  <view class="ticks-note">
    <text>{{ completed }} / {{ total }} 组</text>
    <text class="ticks-pct">{{ percent }}%</text>
  </view>

  <view wx:if="{{ error }}" class="pending" bindtap="retry">{{ error }}</view>

  <block wx:if="{{ saved }}">
    <view class="done">
      <view class="done-mark">✓</view>
      <view class="done-title">今天练完了</view>
      <view class="done-sub">{{ focus }} · {{ completed }} / {{ total }} 组已记录</view>
    </view>
    <button class="primary done-btn" bindtap="back">返回计划</button>
  </block>

  <block wx:else>
    <block wx:if="{{ item }}">
      <!-- 当前组：整页唯一的深色块，视线只落在这里 -->
      <view class="hero">
        <view class="hero-top">
          <text class="hero-step">动作 {{ step }} / {{ steps }}</text>
          <text class="hero-set">第 {{ group }} / {{ item.Sets }} 组</text>
        </view>

        <view class="hero-name">{{ item.Name }}</view>

        <view class="reps">
          <view class="reps-btn" data-d="-1" bindtap="bump" hover-class="reps-btn-on">−</view>
          <input
            class="reps-input"
            type="number"
            value="{{ reps }}"
            bindinput="input"
            cursor-spacing="180"
          />
          <view class="reps-btn" data-d="1" bindtap="bump" hover-class="reps-btn-on">＋</view>
        </view>

        <view class="hero-foot">计划 {{ item.Reps }} 次 · 休息 {{ rest }} 秒</view>
      </view>

      <view class="panel">
        <view class="prow">
          <view class="prow-main">
            <view class="prow-label">重量</view>
            <view class="prow-note">这组用的重量，下次好对照</view>
          </view>
          <view class="prow-field">
            <input
              class="weight"
              type="digit"
              value="{{ weight }}"
              placeholder="—"
              bindinput="weight"
              cursor-spacing="180"
            />
            <text class="weight-unit">kg</text>
          </view>
        </view>

        <view class="pdiv"></view>

        <view class="prow prow-col">
          <view class="prow-label">组间休息</view>
          <view class="seg">
            <view
              wx:for="{{ [30, 60, 90] }}"
              wx:for-item="sec"
              wx:key="*this"
              class="seg-item {{ rest === sec ? 'on' : '' }}"
              data-v="{{ sec }}"
              bindtap="duration"
            >
              {{ sec }} 秒
            </view>
          </view>
        </view>
      </view>

      <!-- 接下来：给换器械留个提前量，也让下方不至于空荡 -->
      <view wx:if="{{ upNext }}" class="upnext">
        <text class="upnext-label">接下来</text>
        <text class="upnext-name">{{ upNext.Name }}</text>
        <text class="upnext-meta">剩 {{ upNext.Left }} 组</text>
      </view>
      <view wx:elif="{{ item }}" class="upnext">
        <text class="upnext-label">这是今天最后一个动作</text>
      </view>

      <!-- 固定底部：训练时手指最常落的位置 -->
      <view class="dock">
        <view class="dock-btn" bindtap="record" hover-class="dock-btn-on">
          <text wx:if="{{ saving }}">保存中…</text>
          <text wx:else>完成本组</text>
        </view>
        <view class="dock-skip" data-skip="{{ true }}" bindtap="record">跳过此动作剩余组</view>
      </view>
    </block>

    <view wx:else class="done">
      <view class="done-title">全部组数已完成</view>
      <view class="done-sub">正在保存这一场训练。</view>
    </view>
  </block>

  <!-- 组间休息：整屏变暗，倒计时环是唯一重心 -->
  <view wx:if="{{ left && !folded }}" class="rest" catchtouchmove="noop">
    <view class="rest-head">
      <text class="rest-eyebrow">组间休息</text>
      <text class="rest-fold" bindtap="fold" hover-class="rest-fold-on">收起</text>
    </view>

    <view class="ring-wrap">
      <view
        class="ring"
        style="background: conic-gradient(#ffffff 0deg {{ deg }}deg, rgba(255,255,255,0.12) {{ deg }}deg 360deg)"
      >
        <view class="ring-in">
          <view class="ring-clock">
            <text class="ring-num">{{ left }}</text>
            <text class="ring-unit">秒</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{ next }}" class="next">
      <text class="next-label">{{ next.Fresh ? "下一个动作" : "下一组" }}</text>
      <view class="next-main">
        <text class="next-name">{{ next.Name }}</text>
        <text class="next-meta">第 {{ next.Group }} / {{ next.Sets }} 组 · {{ next.Reps }} 次</text>
      </view>
      <text wx:if="{{ next.Last }}" class="next-last">这是今天的最后一组</text>
    </view>

    <view class="rest-shift">
      <view class="shift-btn" data-d="-10" bindtap="shift">−10 秒</view>
      <view class="shift-btn" data-d="10" bindtap="shift">+10 秒</view>
    </view>

    <view class="rest-skip" bindtap="skipRest" hover-class="rest-skip-on">跳过休息</view>
    <view class="rest-game" bindtap="game">{{ game ? "收起圆点" : "玩点圆点" }}</view>

    <view wx:if="{{ game }}" class="game">
      <view class="game-dot" style="margin-left: {{ (points % 4) * 20 }}%" bindtap="tapGame">●</view>
      <text class="game-note">命中 {{ points }} 次</text>
    </view>
  </view>

  <!-- 收起形态：底部一条，休息时也能回看动作，点开回到弹窗 -->
  <view wx:if="{{ left && folded }}" class="rest-bar" bindtap="expand">
    <text class="rest-bar-left">休息中 {{ left }} 秒</text>
    <text wx:if="{{ next }}" class="rest-bar-hint">{{ next.Name }} · 第 {{ next.Group }} 组</text>
    <text wx:else class="rest-bar-hint">点击展开</text>
  </view>
</view>
