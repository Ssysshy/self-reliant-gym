<view class="page" wx:if="{{session}}"><button wx:if="{{pending}}" bindtap="retry">本组待同步 · 重试</button><view class="muted">{{session.Day.Focus}} · 已完成 {{completed}} 组</view><rest-timer wx:if="{{left}}" left="{{left}}" bind:finish="skip"/> <block wx:elif="{{item}}"><view class="title">{{item.Name}}</view><view class="sub">第 {{group}} / {{item.Sets}} 组</view><view>实际次数</view><input type="number" value="{{reps}}" bindinput="input"/><view class="row">重量（公斤，选填）</view><input type="digit" value="{{weight}}" bindinput="weight"/><view class="row">组间休息</view><text wx:for="{{[30,60,90]}}" wx:key="*this" class="chip {{rest===item?'on':''}}" data-v="{{item}}" bindtap="duration">{{item}} 秒</text><button class="primary" bindtap="record">完成本组</button><button data-skip="{{true}}" bindtap="record">跳过此动作剩余组</button></block><view wx:else class="title">已完成全部组数</view><button data-finish="{{true}}" bindtap="record">结束训练</button></view>
