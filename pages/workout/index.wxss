@import "../../styles/interactive.wxss";
@import "../../styles/form.wxss";

button {
  box-sizing: border-box;
  width: 100%;
}
button::after {
  border: none;
}

.head {
  margin-bottom: 30rpx;
}
/* 训练页的视觉重心是「当前动作」，顶部部位名让位给小一号 */
.head .title {
  font-size: 36rpx;
  font-weight: 600;
  margin: 0 0 10rpx;
}
.progress-note {
  color: #999;
  font-size: 24rpx;
  margin: 0 0 14rpx;
}

.pending {
  background: #f4f4f2;
  color: #191919;
  font-size: 25rpx;
  text-align: center;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

/* 当前动作：一屏只突出一个 */
.exercise {
  margin: 10rpx 0 34rpx;
}
.exercise-name {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
}
.pill {
  display: inline-block;
  margin-top: 16rpx;
  background: #191919;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.done {
  padding: 40rpx 0 10rpx;
}
.done-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.finish {
  margin-top: 44rpx;
  text-align: center;
  color: #888;
  font-size: 26rpx;
  padding: 24rpx;
  border-top: 1rpx solid #f0f0ee;
}
