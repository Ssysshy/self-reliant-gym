<view class="page">
  <view class="title">训练记录</view>
  <view class="sub">本月 {{ summary.Month || 0 }} 次 · 累计 {{ summary.Total || 0 }} 次</view>

  <view wx:if="{{ !ready }}" class="hint">正在读取记录…</view>
  <view wx:elif="{{ !rows.length }}" class="hint">还没有训练记录。练完一天会自动记在这里。</view>

  <view wx:for="{{ rows }}" wx:key="ID" class="record" data-id="{{ item.ID }}" bindtap="open">
    <view class="grow">
      <view class="record-focus">{{ item.focus }}</view>
      <view class="record-time">{{ item.time }}</view>
    </view>
    <text class="record-done">{{ item.count }}</text>
    <text class="chev">›</text>
  </view>
</view>
