<view class="page"><view class="title">撸铁不求人</view><view class="sub">按自己的计划，练好每一组。</view><view wx:for="{{['动作库','器材库','训练计划']}}" wx:key="*this" class="card" data-kind="{{item}}" bindtap="open"><text class="icon">{{['◎','◇','▤'][index]}}</text><view class="grow"><view class="label">{{item}}</view><view class="muted">{{['了解动作与目标肌群','找到器材的使用方法','安排每周的训练'][index]}}</view></view><text class="arrow">›</text></view><view class="foot" data-kind="记录与账户" bindtap="open">记录与账户</view></view>
<view wx:if="{{stage}}" class="mask"><view class="sheet">
<block wx:if="{{stage==='experience'}}"><view class="label">你是健身小白，还是训练老炮？</view><button wx:for="{{['小白','训练老炮']}}" wx:key="*this" data-v="{{item}}" bindtap="experience">{{item}}</button></block>
<block wx:elif="{{stage==='preferences'}}"><view class="label">我们给你准备了几个训练计划</view><view class="row">一周几练？</view><text wx:for="{{frequencies}}" wx:key="*this" class="chip {{frequency===item?'on':''}}" data-key="frequency" data-v="{{item}}" bindtap="select">{{item}} 练</text><view class="row">想练哪些？</view><text wx:for="{{focuses}}" wx:key="*this" class="chip {{marked[item]?'on':''}}" data-key="focus" data-v="{{item}}" bindtap="select">{{item}}</text><button class="primary" bindtap="match">查看方案</button></block>
<block wx:elif="{{stage==='matches'}}"><view class="label">适合你的方案</view><view wx:if="{{!matches.length}}" class="sub">当前条件暂无匹配方案</view><view wx:for="{{matches}}" wx:key="ID" class="panel"><view>{{item.Name}}</view><view wx:for="{{item.Days}}" wx:for-item="day" wx:key="Weekday" class="row">周{{day.Weekday}} · {{day.Focus}}<view class="muted" wx:for="{{day.Items}}" wx:key="Name">{{item.Name}} {{item.Sets}} × {{item.Reps}}</view></view><button class="primary" data-i="{{index}}" bindtap="adopt">保存</button></view><button bindtap="back">调整条件</button></block>
<block wx:else><view class="label">让我们马上开练吧</view><button class="primary" bindtap="start">猛攻</button></block><view class="foot" bindtap="close">暂时关闭</view></view></view>
