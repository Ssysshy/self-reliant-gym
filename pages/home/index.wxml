<view class="page">
  <view class="title">撸铁不求人</view>
  <view class="sub">按自己的计划，练好每一组。</view>
  <view
    wx:for="{{ entries }}"
    wx:key="label"
    class="card"
    data-kind="{{ item.label }}"
    bindtap="open"
  >
    <text class="icon">{{ item.icon }}</text>
    <view class="grow">
      <view class="label">{{ item.label }}</view>
      <view class="muted">{{ item.desc }}</view>
    </view>
    <text class="arrow">›</text>
  </view>
  <!-- 健身搭子：右下角固定展示，点一下只在上方冒台词，人物本身不动 -->
  <view wx:if="{{ buddy }}" class="buddy" bindtap="talk">
    <image class="buddy-img" src="{{ buddy.ImageURL }}" mode="aspectFill" />
  </view>
  <!-- 气泡是独立一层，不放进 .buddy：父元素的 z-index 会形成层叠上下文，
       气泡再高也跳不出 3，盖不住选模板弹窗（5）和鼓励弹窗（9） -->
  <view wx:if="{{ line }}" class="bubble" bindtap="talk">{{ line }}</view>
</view>
<view wx:if="{{ stage }}" class="mask">
  <view class="sheet">
    <block wx:if="{{ stage === 'templates' }}">
      <view class="sheet-head">
        <view class="sheet-title">还没有训练计划</view>
        <view class="sheet-link" bindtap="custom">自己排计划</view>
      </view>
      <view class="sheet-sub">先挑一套照着练，启用后随时能改。</view>
      <!-- 卡片不用封面图：库里封面走 CDN，没配或加载失败就是一块空黑。
           改成「一周几天 + 时长难度 + 一周周历」的信息卡，选中后左边天数块反白 -->
      <view
        wx:for="{{ templates }}"
        wx:key="ID"
        class="tpl {{ picked === index ? 'picked' : '' }}"
        hover-class="tpl-hover"
        data-i="{{ index }}"
        bindtap="choose"
      >
        <view class="tpl-days">
          <text class="tpl-days-n">{{ item.days }}</text>
          <text class="tpl-days-u">天</text>
        </view>
        <view class="tpl-main">
          <view class="tpl-name">{{ item.Name }}</view>
          <view wx:if="{{ item.meta }}" class="tpl-meta">{{ item.meta }}</view>
          <view class="tpl-week">
            <view
              wx:for="{{ item.week }}"
              wx:for-item="d"
              wx:key="label"
              class="tpl-day {{ d.on ? 'day-on' : '' }}"
            >
              {{ d.label }}
            </view>
          </view>
        </view>
        <view class="tpl-radio {{ picked === index ? 'radio-on' : '' }}"></view>
      </view>
      <button class="btn" bindtap="adopt" loading="{{ saving }}" disabled="{{ saving }}">
        {{ picked === -1 ? "先选一套" : "启用这套计划" }}
      </button>
      <view class="sheet-foot" bindtap="close">暂时关闭</view>
    </block>
  </view>
</view>
<view wx:if="{{ encourage }}" class="enc-mask" bindtap="closeEncourage">
  <view class="enc-card" catchtap="noop">
    <view class="enc-quote">“</view>
    <view class="enc-text">{{ encourage.Text }}</view>
    <view wx:if="{{ encourage.Author }}" class="enc-author">—— {{ encourage.Author }}</view>
    <view class="enc-btn" hover-class="enc-btn-on" bindtap="closeEncourage">收到</view>
  </view>
</view>
