@import "../../styles/card.wxss";
@import "../../styles/interactive.wxss";
@import "../../styles/form.wxss";

button {
  box-sizing: border-box;
  width: 100%;
}
/* 去掉小程序按钮默认的 1px 描边，避免和 .ghost 自己的描边叠成双层 */
button::after {
  border: none;
}

/* 「已安排」里的星期列：和计划库里训练日行的宽度对齐 */
.day-week {
  width: 92rpx;
  color: #888;
  font-size: 26rpx;
}

/* 动作卡：名称一行，下面三格数字；改数字是最频繁的操作，格子要够大够好按 */
.item {
  border: 2rpx solid #e4e4e1;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 16rpx 0;
  background: #fff;
}
.item-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.item-name {
  font-size: 30rpx;
  font-weight: 500;
}
/* 自建动作：动作库里没有，只存在这份计划里 */
.item-tag {
  margin-right: 16rpx;
  padding: 2rpx 10rpx;
  border: 2rpx solid #e4e4e1;
  border-radius: 8rpx;
  color: #999;
  font-size: 22rpx;
}
/* 动作搜索：单输入框，输入即匹配动作库；没有匹配就按文字建自建动作 */
.search {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e4e4e1;
  border-radius: 20rpx;
  background: #fff;
}
.search-input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  /* 全局 input 带灰底和 16rpx 内边距，这里要还原成描边容器里的裸输入 */
  padding: 0;
  background: transparent;
  border-radius: 0;
}
.search-ph {
  color: #b5b5b0;
  font-size: 26rpx;
}
.search-add {
  padding-left: 24rpx;
  color: #171717;
  font-size: 28rpx;
}
.search-add.off {
  color: #c9c9c4;
}
.suggest {
  margin-top: 12rpx;
  border: 2rpx solid #e4e4e1;
  border-radius: 20rpx;
  background: #fff;
  overflow: hidden;
}
.suggest-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  /* 固定行高，候选区才能按「5 行」算高度 */
  height: 88rpx;
  padding: 0 24rpx;
}
.suggest-row + .suggest-row,
.suggest-row.divider {
  border-top: 2rpx solid #f2f2ef;
}
.suggest-row .grow {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.suggest-name {
  font-size: 28rpx;
}
.suggest-meta {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #999;
  font-size: 24rpx;
}
.item-remove {
  color: #a1a19d;
  font-size: 24rpx;
  padding-left: 20rpx;
}
.nums {
  display: flex;
  gap: 12rpx;
}
.num {
  flex: 1;
  background: #f4f4f2;
  border-radius: 14rpx;
  padding: 14rpx 10rpx;
  text-align: center;
}
.num-label {
  color: #999;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}
.num-input {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  background: transparent;
  padding: 0;
  height: 56rpx;
  min-height: 56rpx;
}
