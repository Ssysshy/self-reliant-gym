<view class="page"><view class="title">{{title}}</view><input placeholder="搜索动作、器材或肌群" bindinput="search"/><view wx:if="{{title==='器材库'}}"><view wx:for="{{equipment}}" wx:key="*this" class="card" data-name="{{item}}" bindtap="equipment">{{item}} ›</view></view><block wx:else><view wx:if="{{equipmentName}}" class="panel"><view class="label">{{equipmentName}}</view><view class="row">{{setup}}</view>可练动作</view><view wx:for="{{rows}}" wx:key="ID" class="card" data-i="{{index}}" bindtap="open"><view class="grow">{{item.Name}}</view><text class="muted">{{item.Muscle}} ›</text></view></block><view wx:if="{{detail}}" class="panel"><view class="label">{{detail.Name}}</view><view class="row">{{detail.Muscle}} · {{detail.Equipment}}</view><image wx:if="{{detail.ImageURL}}" mode="widthFix" style="width:100%" src="{{detail.ImageURL}}"/><view wx:if="{{detail.AuxMuscles}}" class="muted">辅助肌群 · {{detail.AuxMuscles}}</view><view>{{detail.Setup}}</view><view class="row">{{detail.Guide}}</view><view wx:if="{{detail.Mistakes}}" class="muted">常见错误 · {{detail.Mistakes}}</view></view></view>
