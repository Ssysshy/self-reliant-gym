@import "../../styles/interactive.wxss";
@import "../../styles/form.wxss";

button {
  box-sizing: border-box;
  width: 100%;
}
button::after {
  border: none;
}

/* 用户编号：跟在说明后面，第一行给编号本身，第二行说明会自动带上，不用用户自己抄 */
.who {
  font-size: 26rpx;
  color: #555;
  letter-spacing: 1rpx;
  margin: -30rpx 0 32rpx;
}
.who-note {
  color: #aaa;
  font-size: 24rpx;
  margin-top: 6rpx;
}

/* 输入区做成一张描边卡，右下角带字数 */
.box {
  border: 2rpx solid #e4e4e1;
  border-radius: 24rpx;
  padding: 24rpx 26rpx 14rpx;
  background: #fff;
  margin-bottom: 26rpx;
}
.note {
  width: 100%;
  height: 320rpx;
  font-size: 30rpx;
  line-height: 1.7;
  background: transparent;
}
.ph {
  color: #b0b0ac;
}
.count {
  text-align: right;
  color: #b0b0ac;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.count.warn {
  color: #c0563f;
}

.done {
  padding: 34rpx 0 14rpx;
}
.done-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
