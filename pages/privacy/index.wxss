@import "../../styles/form.wxss";

.block {
  margin: 34rpx 0;
}
.block-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.block-line {
  position: relative;
  padding-left: 24rpx;
  color: #555;
  font-size: 27rpx;
  line-height: 1.8;
  margin-bottom: 6rpx;
}
.block-line::before {
  content: "·";
  position: absolute;
  left: 4rpx;
  color: #b0b0ac;
}

/* 和服务协议同一套页脚：条款类页面都标更新日期 */
.foot {
  margin-top: 56rpx;
  color: #a8a8a4;
  font-size: 24rpx;
  text-align: center;
}
