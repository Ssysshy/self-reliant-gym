<view class="page">
  <view class="title">隐私说明</view>
  <view class="sub">这里写的是小程序实际会接触到的数据，不是模板话术。</view>

  <view wx:for="{{ blocks }}" wx:key="title" class="block">
    <view class="block-title">{{ item.title }}</view>
    <view wx:for="{{ item.lines }}" wx:for-item="line" wx:key="*this" class="block-line">
      {{ line }}
    </view>
  </view>

  <view class="foot">更新日期：{{ updated }}</view>
</view>
