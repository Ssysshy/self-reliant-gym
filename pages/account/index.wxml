<view class="page"><view class="title">记录与账户</view><view class="sub">训练记录随当前微信账号同步。</view><view wx:for="{{['我的训练记录','个人训练计划库','PRO 会员','我的订单','微信账号同步','反馈','隐私说明']}}" wx:key="*this" class="card" data-v="{{item}}" bindtap="open"><view class="grow">{{item}}<view wx:if="{{index===0}}" class="muted">本月 {{summary.Month||0}} 次 · 累计 {{summary.Total||0}} 次</view></view><text class="muted">{{index===2?member:''}} ›</text></view><view wx:if="{{section==='我的训练记录'}}"><view wx:if="{{!history.length}}" class="sub">暂无训练记录</view><view wx:for="{{history}}" wx:key="ID" class="panel" bindtap="detail" data-i="{{index}}">{{item.Day.Focus}} · {{item.completed}} 组<view class="muted">{{item.Started}} · {{item.Ended?'已结束':'进行中'}}</view></view></view><view wx:if="{{section==='我的训练记录' && detail}}" class="panel"><view wx:for="{{detail.details}}" wx:key="index" class="row">{{item.Name}} · 目标 {{item.Sets}} × {{item.Reps}}<view class="muted">每组实际次数：{{item.Actual}}</view></view></view><view wx:if="{{section==='反馈'}}" class="panel"><textarea maxlength="1000" bindinput="feedback" placeholder="请描述遇到的问题"/><button bindtap="submit">提交反馈</button></view><view wx:if="{{section==='PRO 会员'}}" class="panel">会员状态：{{member}}<view wx:for="{{products}}" wx:key="Days" class="row">{{item.Days}} 天 · ¥{{item.Price/100}}<button disabled="{{!item.Enabled}}" data-days="{{item.Days}}" bindtap="buy">{{item.Enabled?'开通':'暂未开放'}}</button></view></view><view wx:if="{{section==='我的订单'}}" class="panel"><view wx:if="{{!orders.length}}">暂无订单</view><view wx:for="{{orders}}" wx:key="ID">{{item.Days}} 天 · {{item.Status}}<button wx:if="{{item.Status==='待支付'}}" data-id="{{item.ID}}" bindtap="checkOrder">查询到账状态</button></view></view><view wx:if="{{section==='微信账号同步'}}" class="panel">已保存的计划和训练记录随当前账号同步。</view><view wx:if="{{section==='隐私说明'}}" class="panel">账号标识用于关联你的个人计划、训练记录和会员有效期。</view></view>
