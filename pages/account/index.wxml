<view class="page">
  <view class="title">记录与账户</view>
  <view class="sub">已提交的训练记录保存在当前微信账号下；当天进行中的进度只在这台手机。</view>
  <view
    wx:for="{{ ['我的训练记录', '个人训练计划库', 'PRO 会员', '我的订单', '反馈', '服务协议', '隐私说明'] }}"
    wx:key="*this"
    class="card"
    data-v="{{ item }}"
    bindtap="open"
  >
    <view class="grow">
      {{ item }}
      <view wx:if="{{ index === 0 }}" class="muted">
        本月 {{ summary.Month || 0 }} 次 · 累计 {{ summary.Total || 0 }} 次
      </view>
    </view>
    <text class="muted">{{ index === 2 ? member : "" }} ›</text>
  </view>
  <view wx:if="{{ section === 'PRO 会员' }}" class="panel">
    会员状态：{{ member }}
    <view wx:for="{{ products }}" wx:key="Days" class="row">
      {{ item.Days }} 天 · ¥{{ item.Price / 100 }}
      <button disabled="{{ !item.Enabled }}" data-days="{{ item.Days }}" bindtap="buy">
        {{ item.Enabled ? "开通" : "暂未开放" }}
      </button>
    </view>
  </view>
</view>
