@import "../../styles/card.wxss";
@import "../../styles/interactive.wxss";
@import "../../styles/form.wxss";

button {
  box-sizing: border-box;
  width: 100%;
}
/* 去掉小程序按钮默认的 1px 描边，避免和 .ghost 自己的描边叠成双层 */
button::after {
  border: none;
}

/* 星期选择器：点一下切下面的内容。
   选中 = 实心黑；今天 = 描边；本周练过 = 底下一个小点；没安排的那天文字更浅。 */
.week {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}
.week-day {
  position: relative;
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f4f2;
  color: #a8a8a4;
  border-radius: 14rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
/* 有训练安排的那天：字是实的，看得出「这天要练」 */
.week-day.has {
  color: #191919;
}
.week-day.today {
  border-color: #191919;
}
.week-day.sel {
  background: #191919;
  color: #fff;
  border-color: #191919;
  font-weight: 600;
}
/* 本周已练过：一个小点，选中时反白 */
.dot {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  border-radius: 50%;
  background: #191919;
}
.dot.on {
  background: #fff;
}
.week-note {
  color: #999;
  font-size: 24rpx;
  margin: 14rpx 0 32rpx;
}

/* 未结束的训练：全页唯一的深色卡片，用来抢视觉 */
.resume {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #191919;
  color: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 26rpx;
}
.resume-title {
  font-size: 32rpx;
  font-weight: 600;
}
.resume-sub {
  color: #b9b9b6;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.resume-arrow {
  color: #777;
  font-size: 36rpx;
  line-height: 1;
}

/* 最近一次训练：一行低调的回顾，不和「继续训练」抢注意力 */
.last {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 6rpx;
  margin: -6rpx 0 24rpx;
}
.last-label {
  color: #aaa;
  font-size: 24rpx;
}
.last-value {
  color: #666;
  font-size: 24rpx;
}

/* 当前计划卡：标题行 + 选中那天的安排 + 主按钮 */
.plan {
  border: 2rpx solid #e4e4e1;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 16rpx 0;
  background: #fff;
}
.plan-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
/* 名字整块可点（去详情页），窄屏时省略而不是挤掉右边的操作 */
.plan-title {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.plan-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 600;
}
.badge {
  background: #191919;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex: none;
}
/* 「调整」是次要入口，挂在计划名右侧，不占主按钮的位置 */
.plan-adjust {
  color: #888;
  font-size: 24rpx;
  padding: 8rpx 0 8rpx 4rpx;
  flex: none;
}
/* 「删除」比「调整」更弱但要能看见：浅一档的灰，靠确认弹窗兜住误触 */
.plan-del {
  color: #a8a8a4;
  font-size: 24rpx;
  padding: 8rpx 0 8rpx 4rpx;
  flex: none;
}

/* 选中那天的概览 */
.day-head {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0ee;
}
.day-focus {
  font-size: 32rpx;
  font-weight: 600;
}
.day-meta {
  color: #999;
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 动作清单：一行一个，右侧是组次与休息 */
.items {
  margin-top: 18rpx;
}
.item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f4f4f2;
}
.item-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
}
.item-sets {
  color: #666;
  font-size: 26rpx;
  flex: none;
}
.item-rest {
  color: #b0b0ac;
  font-size: 24rpx;
  width: 62rpx;
  text-align: right;
  flex: none;
}
.item .chev {
  font-size: 30rpx;
}

/* 主按钮独占一行；次要的「调整」已移到计划名右侧 */
.plan-actions {
  margin-top: 22rpx;
}
.plan-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 多份计划时的切换入口：一行低调的文字，不抢主按钮 */
.switch {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 6rpx;
  margin-bottom: 6rpx;
}
.switch-label {
  font-size: 28rpx;
  color: #191919;
}
.switch-sub {
  flex: 1;
  font-size: 24rpx;
  color: #aaa;
}

/* 底部两个次要入口并排 */
.duo {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}
.duo button {
  flex: 1;
  width: auto;
  margin: 0;
}
