<view class="page">
  <view class="title">训练计划</view>

  <block wx:if="{{ !smart }}">
    <!-- 星期选择器：一格里同时表示「这天有安排 / 本周练过 / 今天」，点它就是切换下面的内容 -->
    <view class="week">
      <view
        wx:for="{{ weekView }}"
        wx:key="d"
        class="week-day {{ item.has ? 'has' : 'rest' }} {{ item.sel ? 'sel' : '' }} {{ item.today && !item.sel ? 'today' : '' }}"
        data-d="{{ item.d }}"
        bindtap="pickDay"
      >
        <text>{{ item.label }}</text>
        <view wx:if="{{ item.done }}" class="dot {{ item.sel ? 'on' : '' }}"></view>
      </view>
    </view>
    <view class="week-note">本周已完成 {{ completed.length || 0 }} 个训练日</view>

    <view wx:if="{{ !plans.length }}" class="hint">
      还没有计划。挑一个免费模板开始，或者自己排一周。
    </view>

    <view wx:if="{{ local }}" class="resume" bindtap="resume">
      <view class="grow">
        <view class="resume-title">继续未结束训练</view>
        <view class="resume-sub">
          {{ local.Focus }} · 已完成 {{ local.done }} / {{ local.total }} 组
        </view>
      </view>
      <text class="resume-arrow">›</text>
    </view>

    <!-- 没有进行中的训练时，露出最近一次真正练完的记录 -->
    <view wx:if="{{ !local && lastSession }}" class="last">
      <text class="last-label">最近一次训练</text>
      <view class="last-value">
        {{ lastSession.focus }} · {{ lastSession.done }} / {{ lastSession.total }} 组
      </view>
    </view>

    <!-- 当前计划：只有一份在练，所以只展示这一份；内容跟着上面的星期走 -->
    <view wx:if="{{ active }}" class="plan">
      <view class="plan-head">
        <view class="plan-title" bindtap="openPlan">
          <text class="plan-name">{{ active.Name }}</text>
          <text class="chev">›</text>
        </view>
        <text class="badge">当前</text>
        <text class="plan-adjust" data-id="{{ active.ID }}" bindtap="modify">调整</text>
        <text class="plan-del" bindtap="del">删除</text>
      </view>

      <view class="day-head">
        <view class="day-focus">{{ day.rest ? "休息日" : day.focus }}</view>
        <view wx:if="{{ !day.rest }}" class="day-meta">
          周{{ day.label }} · {{ day.items.length }} 个动作 · {{ day.sets }} 组 · 约
          {{ day.minutes }} 分钟
        </view>
        <view wx:else class="day-meta">周{{ day.label }} 没有安排训练，切上面其它天看看</view>
      </view>

      <view wx:if="{{ !day.rest }}" class="items">
        <view
          wx:for="{{ day.items }}"
          wx:key="key"
          class="item"
          data-id="{{ item.id }}"
          bindtap="openExercise"
        >
          <text class="item-name">{{ item.Name }}</text>
          <text class="item-sets">{{ item.Sets }} × {{ item.Reps }}</text>
          <text class="item-rest">{{ item.Rest }}s</text>
          <text wx:if="{{ item.id }}" class="chev">›</text>
        </view>
      </view>

      <view class="plan-actions">
        <button wx:if="{{ !day.rest }}" class="primary" bindtap="startDay">开始或继续训练</button>
        <button wx:else class="ghost" data-id="{{ active.ID }}" bindtap="modify">调整计划</button>
      </view>
    </view>

    <view wx:if="{{ plans.length > 1 }}" class="switch" bindtap="switchPlan">
      <text class="switch-label">切换计划</text>
      <text class="switch-sub">共 {{ plans.length }} 份</text>
      <text class="chev">›</text>
    </view>

    <view class="card" bindtap="browse">
      <view class="grow">
        <view class="row-main">从推荐计划开始</view>
        <view class="row-meta">看完整套安排再决定，详情里可以直接启用</view>
      </view>
      <text class="chev">›</text>
    </view>

    <view class="duo">
      <button class="ghost" bindtap="smart">PRO 智能生成</button>
      <button class="ghost" bindtap="edit">自定义周计划</button>
    </view>
  </block>

  <!-- 智能生成：先收条件，再出草案 -->
  <block wx:else>
    <view class="sub">告诉它你什么时候练、手上有什么器材。</view>

    <view class="section">
      <view class="section-title">每周训练日</view>
      <view class="seg wrap">
        <view
          wx:for="{{ dayOpts }}"
          wx:key="d"
          class="seg-item {{ item.on ? 'on' : '' }}"
          data-v="{{ item.d }}"
          bindtap="toggleDay"
        >
          周{{ item.label }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">可用器材</view>
      <view class="seg wrap">
        <view
          wx:for="{{ gearOpts }}"
          wx:key="v"
          class="seg-item {{ item.on ? 'on' : '' }}"
          data-v="{{ item.v }}"
          bindtap="toggleGear"
        >
          {{ item.v }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">训练部位</view>
      <view class="seg wrap">
        <view
          wx:for="{{ focusOpts }}"
          wx:key="v"
          class="seg-item {{ item.on ? 'on' : '' }}"
          data-v="{{ item.v }}"
          bindtap="pickFocus"
        >
          {{ item.v }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">单次时长</view>
      <view class="field-row">
        <input
          class="field"
          type="number"
          value="{{ minutes }}"
          data-key="minutes"
          bindinput="choices"
        />
        <text class="field-unit">分钟</text>
      </view>
    </view>

    <button class="primary" bindtap="generate">生成计划草案</button>
    <view class="link" bindtap="cancel">返回计划库</view>
  </block>
</view>
