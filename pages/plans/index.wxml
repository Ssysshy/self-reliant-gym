<view class="page"><view class="title">训练计划</view><block wx:if="{{smart}}"><view>每周训练日</view><checkbox-group data-key="selectedDays" bindchange="choices"><label wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this"><checkbox value="{{item}}"/>周{{item}}</label></checkbox-group><view class="row">可用器材</view><checkbox-group data-key="selectedGear" bindchange="choices"><label wx:for="{{gear}}" wx:key="*this"><checkbox value="{{item}}"/>{{item}}</label></checkbox-group><picker range="{{focuses}}" bindchange="focus"><view class="card">训练部位 · {{focus}} ›</view></picker><view>单次分钟数</view><input type="number" value="{{minutes}}" data-key="minutes" bindinput="choices"/><button class="primary" bindtap="generate">生成计划草案</button></block><block wx:elif="{{edit}}"><input value="{{name}}" placeholder="计划名称" bindinput="name"/><picker range="{{['周一','周二','周三','周四','周五','周六','周日']}}" bindchange="week"><view class="card">训练日 · 周{{week}} ›</view></picker><picker range="{{exercises}}" range-key="Name" bindchange="add"><view class="card">添加动作 ›</view></picker><view class="panel" wx:for="{{items}}" wx:key="index">{{item.Name}}<button data-i="{{index}}" bindtap="removeItem">移除动作</button><view wx:for="{{['Sets','Reps','Rest']}}" wx:for-item="k" wx:for-index="n" wx:key="*this">{{['组数','次数','休息秒数'][n]}}<input type="number" value="{{item[k]}}" data-i="{{index}}" data-k="{{k}}" bindinput="field"/></view></view><button bindtap="day">保存此训练日</button><view wx:for="{{days}}" wx:key="Weekday">周{{item.Weekday}} · {{item.Focus}}</view><button class="primary" bindtap="save">保存计划</button></block><block wx:else><view wx:if="{{currentSession}}" class="card" data-id="{{currentSession.PlanID}}" bindtap="start">继续未结束训练 ›</view><view class="sub">本周已完成 {{completed.length||0}} 个训练日</view><view wx:for="{{plans}}" wx:key="ID" class="panel"><view class="label">{{item.Name}} {{activeId===item.ID?"· 当前":""}}</view><view wx:for="{{item.Days}}" wx:for-item="day" wx:key="Weekday" class="card" data-id="{{item.ID}}" data-day="{{day.Weekday}}" bindtap="start">周{{day.Weekday}} · {{day.Focus}} ›</view><button data-i="{{index}}" bindtap="modify">调整并另存计划</button><button class="primary" data-id="{{item.ID}}" bindtap="start">开始或继续训练</button></view><picker range="{{templates}}" range-key="Name" bindchange="useTemplate"><view class="card">选择免费模板 ›</view></picker><button bindtap="smart">PRO 智能生成</button><button bindtap="edit">自定义周计划</button></block></view>
