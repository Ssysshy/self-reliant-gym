<view class="page">
  <view class="title">训练计划</view>

  <!-- 计划库：本周进度 + 当前计划的训练日 -->
  <block wx:if="{{ !smart && !edit }}">
    <view class="week">
      <view
        wx:for="{{ weekView }}"
        wx:key="d"
        class="week-day {{ item.done ? 'done' : '' }} {{ item.today ? 'today' : '' }}"
      >
        {{ item.label }}
      </view>
    </view>
    <view class="week-note">本周已完成 {{ completed.length || 0 }} 个训练日</view>

    <view wx:if="{{ !plans.length }}" class="hint">
      还没有计划。挑一个免费模板开始，或者自己排一周。
    </view>

    <view wx:if="{{ local }}" class="resume" bindtap="resume">
      <view class="grow">
        <view class="resume-title">继续未结束训练</view>
        <view class="resume-sub">
          {{ local.Focus }} · 已完成 {{ local.done }} / {{ local.total }} 组
        </view>
      </view>
      <text class="resume-arrow">›</text>
    </view>

    <!-- 没有进行中的训练时，露出最近一次真正练完的记录 -->
    <view wx:if="{{ !local && lastSession }}" class="last">
      <text class="last-label">最近一次训练</text>
      <view class="last-value">
        {{ lastSession.focus }} · {{ lastSession.done }} / {{ lastSession.total }} 组
      </view>
    </view>

    <view wx:for="{{ plans }}" wx:key="ID" class="plan">
      <view class="plan-head">
        <text class="plan-name">{{ item.Name }}</text>
        <text wx:if="{{ activeId === item.ID }}" class="badge">当前</text>
      </view>
      <view class="days">
        <view
          wx:for="{{ item.Days }}"
          wx:for-item="day"
          wx:key="Weekday"
          class="day-row"
          data-id="{{ item.ID }}"
          data-day="{{ day.Weekday }}"
          bindtap="start"
        >
          <text class="day-week">周{{ day.Weekday }}</text>
          <text class="grow day-focus">{{ day.Focus }}</text>
          <text class="day-count">{{ day.Items.length || 0 }} 个动作</text>
          <text class="chev">›</text>
        </view>
      </view>
      <view class="plan-actions">
        <button class="ghost" data-i="{{ index }}" bindtap="modify">调整并另存</button>
        <button class="primary" data-id="{{ item.ID }}" bindtap="start">开始或继续训练</button>
      </view>
    </view>

    <picker range="{{ templates }}" range-key="Name" bindchange="useTemplate">
      <view class="card">
        <view class="grow">
          <view class="row-main">选择免费模板</view>
          <view class="row-meta">从运营发布的周计划开始，再按自己情况改</view>
        </view>
        <text class="chev">›</text>
      </view>
    </picker>

    <view class="duo">
      <button class="ghost" bindtap="smart">PRO 智能生成</button>
      <button class="ghost" bindtap="edit">自定义周计划</button>
    </view>
  </block>

  <!-- 智能生成：先收条件，再出草案 -->
  <block wx:elif="{{ smart }}">
    <view class="sub">告诉它你什么时候练、手上有什么器材。</view>

    <view class="section">
      <view class="section-title">每周训练日</view>
      <view class="seg wrap">
        <view
          wx:for="{{ dayOpts }}"
          wx:key="d"
          class="seg-item {{ item.on ? 'on' : '' }}"
          data-v="{{ item.d }}"
          bindtap="toggleDay"
        >
          周{{ item.label }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">可用器材</view>
      <view class="seg wrap">
        <view
          wx:for="{{ gearOpts }}"
          wx:key="v"
          class="seg-item {{ item.on ? 'on' : '' }}"
          data-v="{{ item.v }}"
          bindtap="toggleGear"
        >
          {{ item.v }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">训练部位</view>
      <view class="seg wrap">
        <view
          wx:for="{{ focusOpts }}"
          wx:key="v"
          class="seg-item {{ item.on ? 'on' : '' }}"
          data-v="{{ item.v }}"
          bindtap="pickFocus"
        >
          {{ item.v }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">单次时长</view>
      <view class="field-row">
        <input
          class="field"
          type="number"
          value="{{ minutes }}"
          data-key="minutes"
          bindinput="choices"
        />
        <text class="field-unit">分钟</text>
      </view>
    </view>

    <button class="primary" bindtap="generate">生成计划草案</button>
    <view class="link" bindtap="cancel">返回计划库</view>
  </block>

  <!-- 编辑：一周的训练日与动作 -->
  <block wx:else>
    <view class="sub">一个训练日一组动作，保存后再排下一天。</view>

    <view class="section">
      <view class="section-title">计划名称</view>
      <input class="field" value="{{ name }}" placeholder="例如：上下肢三分化" bindinput="name" />
    </view>

    <view class="section">
      <view class="section-title">训练日</view>
      <view class="seg">
        <view
          wx:for="{{ weekChips }}"
          wx:key="d"
          class="seg-item {{ week === item.d ? 'on' : '' }}"
          data-v="{{ item.d }}"
          bindtap="pickWeek"
        >
          {{ item.label }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">
        动作
        <text class="section-note">周{{ week }}</text>
      </view>
      <picker range="{{ exercises }}" range-key="Name" bindchange="add">
        <view class="card">
          <view class="grow row-main">添加动作</view>
          <text class="chev">›</text>
        </view>
      </picker>

      <view wx:for="{{ items }}" wx:key="index" class="item">
        <view class="item-head">
          <text class="grow item-name">{{ item.Name }}</text>
          <text class="item-remove" data-i="{{ index }}" bindtap="removeItem">移除</text>
        </view>
        <view class="nums">
          <view
            wx:for="{{ ['Sets', 'Reps', 'Rest'] }}"
            wx:for-item="k"
            wx:for-index="n"
            wx:key="*this"
            class="num"
          >
            <view class="num-label">{{ ["组数", "次数", "休息秒"][n] }}</view>
            <input
              class="num-input"
              type="number"
              value="{{ item[k] }}"
              data-i="{{ index }}"
              data-k="{{ k }}"
              bindinput="field"
            />
          </view>
        </view>
      </view>
      <view wx:if="{{ !items.length }}" class="hint">
        周{{ week }}还没有动作，先加一个再保存。
      </view>

      <button class="ghost" bindtap="day">保存此训练日</button>
    </view>

    <view class="section" wx:if="{{ days.length }}">
      <view class="section-title">已安排</view>
      <view class="list">
        <view wx:for="{{ days }}" wx:key="Weekday" class="row-item">
          <text class="day-week">周{{ item.Weekday }}</text>
          <text class="grow row-main">{{ item.Focus }}</text>
          <text class="muted">{{ item.Items.length }} 个动作</text>
        </view>
      </view>
    </view>

    <button class="primary" bindtap="save">保存计划</button>
  </block>
</view>
