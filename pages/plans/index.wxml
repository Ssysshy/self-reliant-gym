<view class="page">
  <view class="title">训练计划</view>

  <!-- 计划库：本周进度 + 当前计划的训练日 -->
  <block wx:if="{{ !smart }}">
    <view class="week">
      <view
        wx:for="{{ weekView }}"
        wx:key="d"
        class="week-day {{ item.done ? 'done' : '' }} {{ item.today ? 'today' : '' }}"
      >
        {{ item.label }}
      </view>
    </view>
    <view class="week-note">本周已完成 {{ completed.length || 0 }} 个训练日</view>

    <view wx:if="{{ !plans.length }}" class="hint">
      还没有计划。挑一个免费模板开始，或者自己排一周。
    </view>

    <view wx:if="{{ local }}" class="resume" bindtap="resume">
      <view class="grow">
        <view class="resume-title">继续未结束训练</view>
        <view class="resume-sub">
          {{ local.Focus }} · 已完成 {{ local.done }} / {{ local.total }} 组
        </view>
      </view>
      <text class="resume-arrow">›</text>
    </view>

    <!-- 没有进行中的训练时，露出最近一次真正练完的记录 -->
    <view wx:if="{{ !local && lastSession }}" class="last">
      <text class="last-label">最近一次训练</text>
      <view class="last-value">
        {{ lastSession.focus }} · {{ lastSession.done }} / {{ lastSession.total }} 组
      </view>
    </view>

    <view wx:for="{{ plans }}" wx:key="ID" class="plan">
      <view class="plan-head">
        <text class="plan-name">{{ item.Name }}</text>
        <text wx:if="{{ activeId === item.ID }}" class="badge">当前</text>
        <text wx:else class="badge off">未启用</text>
        <text class="plan-adjust" data-id="{{ item.ID }}" bindtap="modify">调整</text>
        <text class="plan-del" data-i="{{ index }}" bindtap="del">删除</text>
      </view>
      <view class="days">
        <view
          wx:for="{{ item.Days }}"
          wx:for-item="day"
          wx:key="Weekday"
          class="day-row"
          data-id="{{ item.ID }}"
          data-day="{{ day.Weekday }}"
          bindtap="start"
        >
          <text class="day-week">周{{ day.Weekday }}</text>
          <text class="grow day-focus">{{ day.Focus }}</text>
          <text class="day-count">{{ day.Items.length || 0 }} 个动作</text>
          <text class="chev">›</text>
        </view>
      </view>
      <view class="plan-actions">
        <button class="primary" data-id="{{ item.ID }}" bindtap="start">开始或继续训练</button>
      </view>
    </view>

    <view class="card" bindtap="browse">
      <view class="grow">
        <view class="row-main">从推荐计划开始</view>
        <view class="row-meta">看完整套安排再决定，详情里可以直接启用</view>
      </view>
      <text class="chev">›</text>
    </view>

    <view class="duo">
      <button class="ghost" bindtap="smart">PRO 智能生成</button>
      <button class="ghost" bindtap="edit">自定义周计划</button>
    </view>
  </block>

  <!-- 智能生成：先收条件，再出草案 -->
  <block wx:else>
    <view class="sub">告诉它你什么时候练、手上有什么器材。</view>

    <view class="section">
      <view class="section-title">每周训练日</view>
      <view class="seg wrap">
        <view
          wx:for="{{ dayOpts }}"
          wx:key="d"
          class="seg-item {{ item.on ? 'on' : '' }}"
          data-v="{{ item.d }}"
          bindtap="toggleDay"
        >
          周{{ item.label }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">可用器材</view>
      <view class="seg wrap">
        <view
          wx:for="{{ gearOpts }}"
          wx:key="v"
          class="seg-item {{ item.on ? 'on' : '' }}"
          data-v="{{ item.v }}"
          bindtap="toggleGear"
        >
          {{ item.v }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">训练部位</view>
      <view class="seg wrap">
        <view
          wx:for="{{ focusOpts }}"
          wx:key="v"
          class="seg-item {{ item.on ? 'on' : '' }}"
          data-v="{{ item.v }}"
          bindtap="pickFocus"
        >
          {{ item.v }}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">单次时长</view>
      <view class="field-row">
        <input
          class="field"
          type="number"
          value="{{ minutes }}"
          data-key="minutes"
          bindinput="choices"
        />
        <text class="field-unit">分钟</text>
      </view>
    </view>

    <button class="primary" bindtap="generate">生成计划草案</button>
    <view class="link" bindtap="cancel">返回计划库</view>
  </block>
</view>
