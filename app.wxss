/**
 * 全局基座样式：只放所有页面与组件共享的排版原子与表单元素。
 * 页面/组件专属样式见 pages/页面名/index.wxss 与 components/组件名/index.wxss，
 * 跨页复用的样式片段见 styles/。
 */
page {
  background: #fff;
  color: #191919;
  font-family: sans-serif;
}

/* 页面容器：五个页面统一的内边距 */
.page {
  padding: 48rpx 54rpx 100rpx;
}

/* 排版原子 */
.title {
  font-size: 54rpx;
  font-weight: 700;
  margin: 32rpx 0 14rpx;
}
.sub,
.muted {
  color: #777;
  font-size: 26rpx;
  line-height: 1.6;
}
.sub {
  margin-bottom: 44rpx;
}
.row {
  margin: 20rpx 0;
}

/* 表单元素：小程序原生控件无法用 class 精确覆盖时按标签统一 */
input {
  padding: 16rpx;
  background: #f4f4f2;
  border-radius: 12rpx;
}
button {
  border-radius: 18rpx;
  font-size: 28rpx;
  margin: 18rpx 0;
  padding: 12rpx;
}
