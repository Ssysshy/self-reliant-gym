page{background:#fff;color:#191919;font-family:sans-serif}.page{padding:48rpx 54rpx 100rpx}.title{font-size:54rpx;font-weight:700;margin:32rpx 0 14rpx}.sub,.muted{color:#777;font-size:26rpx;line-height:1.6}.sub{margin-bottom:44rpx}.card,.panel{border:2rpx solid #e4e4e1;border-radius:24rpx;padding:28rpx;margin:16rpx 0;background:#fff}.card{display:flex;align-items:center;gap:22rpx}.label{font-weight:600;font-size:32rpx}.grow{flex:1}.icon{width:58rpx;text-align:center;font-size:42rpx}.arrow{color:#aaa}.foot{text-align:center;color:#888;font-size:25rpx;margin-top:62rpx}.primary,button{border-radius:18rpx;font-size:28rpx;margin:18rpx 0;padding:12rpx}.primary{background:#171717;color:white}.mask{position:fixed;inset:0;background:#0005;display:flex;align-items:center;padding:50rpx;z-index:5}.sheet{width:100%;background:#fff;padding:36rpx;border-radius:28rpx;max-height:80vh;overflow:auto;box-sizing:border-box}.chip{display:inline-block;border:1px solid #ccc;padding:12rpx 20rpx;border-radius:40rpx;margin:8rpx}.on{background:#191919;color:white}.row{margin:20rpx 0}.number{font-size:100rpx;font-weight:700}input{padding:16rpx;background:#f4f4f2;border-radius:12rpx}
