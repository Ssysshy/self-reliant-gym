<view class="timer">
  <view class="timer-label">组间休息</view>
  <view class="timer-num">
    {{ left }}
    <text class="timer-unit">秒</text>
  </view>
  <view class="timer-hint">{{ game ? "命中 " + points + " 次" : "呼吸放缓，下一组再发力" }}</view>

  <view wx:if="{{ game }}" class="timer-game">
    <view class="timer-dot" style="margin-left: {{ (points % 4) * 20 }}%" bindtap="tap">●</view>
  </view>

  <view class="timer-actions">
    <view wx:if="{{ !game }}" class="timer-action" bindtap="play">玩点圆点</view>
    <view class="timer-action" bindtap="finish">提前结束</view>
  </view>
</view>
