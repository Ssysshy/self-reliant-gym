/* 组间休息：整块描边卡片，倒计时是唯一的视觉重心。
   组件已设 styleIsolation: apply-shared，全局原子样式可直接继承。 */
.timer {
  border: 2rpx solid #e4e4e1;
  border-radius: 24rpx;
  padding: 40rpx 30rpx 26rpx;
  margin: 10rpx 0 30rpx;
  text-align: center;
  background: #fff;
}
.timer-label {
  color: #999;
  font-size: 24rpx;
}
.timer-num {
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1.1;
  margin: 10rpx 0 4rpx;
  letter-spacing: -2rpx;
}
.timer-unit {
  font-size: 30rpx;
  font-weight: 400;
  color: #999;
  margin-left: 6rpx;
}
.timer-hint {
  color: #a8a8a4;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}
.timer-game {
  display: flex;
  align-items: center;
  background: #f4f4f2;
  border-radius: 18rpx;
  height: 128rpx;
  margin: 18rpx 0 6rpx;
  padding-right: 16rpx;
}
.timer-dot {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #191919;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
.timer-actions {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0ee;
}
.timer-action {
  color: #888;
  font-size: 25rpx;
  padding: 8rpx 10rpx;
}
